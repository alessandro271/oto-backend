[Unit]
# Les travaux de maintenance du backend, SORTIS du démarrage (ADR 0065, lot 0 —
# oto-backend#426). Purge du fil des runs et des étiquettes orphelines, re-projection
# des blocs de nœuds, index d'unicité de clé métier par namespace : trois travaux à la
# forme d'un cron qui tournaient dans la fenêtre du healthcheck de chaque déploiement,
# et dont le coût suit la taille de la base — donc le seul poste du boot capable de
# faire rollbacker un déploiement sain sans que rien n'ait changé dans le lot.
# Même modèle que oto-journal-archive : hors du processus MCP, qui est mono-boucle.
Description=Maintenance du backend oto (purge, re-projection, index)
Documentation=file:///opt/oto-mcp/oto_mcp/maintenance.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Le même environnement que le backend, jamais une copie (une copie divergerait le
# jour d'une rotation de clé) : le `.env` partagé porte le non-secret (fenêtres de
# rétention…), et les secrets (DATABASE_URL…) arrivent par le lanceur générique, comme
# pour le service — le `.env` n'en porte plus (#967, lot 5).
EnvironmentFile=/opt/oto-mcp/.env
EnvironmentFile=/etc/oto-mcp/lanceur-prod.env
LoadCredential=scw:/etc/oto-mcp/scw.key
# @ARBRE@ est réécrit à la pose (`install_timers` de deploy/oto-backend.sh) par l'arbre de
# la couleur EN SERVICE : le lanceur est dans le tag, et l'autre couleur peut porter un tag
# qui n'en a pas encore. Le fichier n'est pas exécutable tel quel.
WorkingDirectory=@ARBRE@
ExecStart=@ARBRE@/.venv/bin/python @ARBRE@/deploy/lanceur_secrets.py maintenance all
# Ne doit jamais concurrencer le service qui répond aux utilisateurs.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
SyslogIdentifier=oto-mcp-maintenance
