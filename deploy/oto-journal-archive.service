[Unit]
# Archive puis purge le journal d'appels au-delà de la rétention (cf. archive_tool_calls.py).
# Hors du processus MCP à dessein : celui-ci est mono-boucle, et c'est précisément ce
# journal qui l'a gelé le 2026-08-27 quand une de ses lectures est devenue lente.
Description=Archivage du journal d'appels oto (rétention + froid S3)
Documentation=file:///opt/oto-mcp/deploy/archive_tool_calls.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Le script lit DATABASE_URL et OTO_MCP_S3_* — le même environnement que le backend,
# jamais une copie (une copie divergerait le jour d'une rotation de clé) : le `.env`
# partagé porte le non-secret (endpoint, région, bucket), les secrets arrivent par le
# lanceur générique (#967, lot 5), qui exécute le script VERSIONNÉ de l'arbre du tag.
# Cette unité n'est pas posée par le déploiement : le remplacement se fait à la main,
# après avoir vidé le `.env` de ses secrets (docs/instance-cible.md §Passer notre box
# au lanceur). Bleu = /opt/oto-mcp ; l'arbre nommé doit porter le lanceur.
EnvironmentFile=/opt/oto-mcp/.env
EnvironmentFile=/etc/oto-mcp/lanceur-prod.env
LoadCredential=scw:/etc/oto-mcp/scw.key
ExecStart=/opt/oto-mcp/.venv/bin/python /opt/oto-mcp/deploy/lanceur_secrets.py --script deploy/archive_tool_calls.py
# Un export volumineux ne doit pas concurrencer le service qui répond aux utilisateurs.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
